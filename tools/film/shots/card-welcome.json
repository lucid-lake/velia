{
  "name": "card-welcome",
  "title": "Velia: the welcome",
  "about": "The first-visit welcome over the live bay at 17:00 (the live render behind the card, the hero photo hidden in film; the same view the sail opens on): How do you sail? The dot taps New to it.",
  "ui": true,
  "duration": 2.4,
  "fps": 60,
  "settle": 1,
  "settleMs": 6000,
  "waitFor": "document.getElementById('lk-load')?.dataset.state === 'home'",
