    "mode": "sail",
    "hour": 17,
    "seed": 1,
    "wind": 3,
    "cloudcov": 0.18,
    "gate": 1,
    "welcome": 1,
    "start": "-330,40",
    "heading": 60
  },
  "inputs": [
    {
      "t": 1.4,
      "tap": "text=New to it"
    }
  ],
  "formats": {
    "L": {
      "w": 3840,
      "h": 2160,
      "view": [
        1920,
        1080
      ],
      "dpr": 2,
      "pixelratio": 2,
      "mbps": 50,
      "hide": [
        ".lk-bg",
        ".lk-wash",
        ".lk-still",
        ".lk-cv",
        ".lk-helm",
        ".lk-hudc",
        ".lk-cp",
        ".lk-cpx",
        ".lk-thr",
        ".lk-view",
        ".lk-dock",
        ".lk-hint",
        ".lk-guide",
        ".toast",
        ".lk-chart",
        ".lk-rd"
      ]
    },
    "P": {
      "w": 2160,
      "h": 3840,
      "view": [
        432,
